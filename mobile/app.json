      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.webskin.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#07080F",
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4b36d5dc-8852-4b32-a93d-3d083cbebb38"
      }
    },
    "owner": "strawhat98",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4b36d5dc-8852-4b32-a93d-3d083cbebb38"
    }
  }
